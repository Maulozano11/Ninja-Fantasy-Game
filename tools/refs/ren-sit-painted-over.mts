// What the owner painted his Ren sit over (docs/reference/ren-sit-owner-reference.jpg, lower row): our Ren on
// the bulky body seated on his talking rock, as fix/throw-neck-forearm drew him at a0ddf04, frames 0-3. It
// writes tools/refs/ren_sit_painted_over.py for tools/refs/ren-sit-from-ref.py: the rig's joints in those
// frames (fine pixels) and, for each frame, where that figure covered the rock (his figure there is drawn
// over our rock, so the rock's colours tell nothing), and the male body's pelvis in the sit, the joint his
// frames are pinned to in the game (they go on the male body). Run once; rerun only if his picture is
// replaced or the male sit's pelvis moves.
//
//   npx tsx tools/refs/ren-sit-painted-over.mts

import { writeFileSync } from 'node:fs';
import { LEGENDARY_PRESETS } from '../../src/data/shinobiData';
import { renderSprite, spriteLayers } from '../../src/sprite/compose';
import { dojutsuToEye } from '../../src/sprite/legacy';
import { GRID, RES } from '../../src/sprite/raster';
import { renderSeat } from '../../src/sprite/seats';

const ren = LEGENDARY_PRESETS.find((p) => p.character.id === 'preset_night')!.character;
const look = { ...ren.appearance!, body: 'bulky' as const };
const names = ['head', 'neck', 'pelvis', 'shoulderN', 'shoulderF', 'elbowN', 'elbowF', 'wristN', 'wristF', 'handN', 'handF', 'hipN', 'hipF', 'kneeN', 'kneeF', 'ankleN', 'ankleF'] as const;
const rock = renderSeat('seat_rock_sit');
const out = ['"""Generated by tools/refs/ren-sit-painted-over.mts: what the owner painted his Ren sit over. Do not edit."""', '', 'JOINTS = {'];
const masks: string[] = ['OVER_ROCK = {'];
for (let f = 0; f < 4; f++) {
  const { rig } = spriteLayers(look, 'sit', f);
  out.push(`    ${f}: {${names.map((n) => `'${n}': (${(rig[n].x * RES).toFixed(6)}, ${(rig[n].y * RES).toFixed(6)})`).join(', ')}},`);
  const fr = renderSprite(look, 'sit', f, dojutsuToEye(ren.dojutsu));
  const cells: string[] = [];
  for (let i = 0; i < GRID * GRID; i++) if (rock[i * 4 + 3] && fr.rgba[i * 4 + 3]) cells.push(`(${i % GRID}, ${(i / GRID) | 0})`);
  masks.push(`    ${f}: {${cells.join(', ')}},`);
}
out.push('}', '', ...masks, '}', '', 'MALE_PELVIS = {');
for (let f = 0; f < 4; f++) {
  const { rig } = spriteLayers({ ...ren.appearance!, body: 'male' }, 'sit', f);
  out.push(`    ${f}: (${(rig.pelvis.x * RES).toFixed(6)}, ${(rig.pelvis.y * RES).toFixed(6)}),`);
}
out.push('}', '');
writeFileSync('tools/refs/ren_sit_painted_over.py', out.join('\n'));
